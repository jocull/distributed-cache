<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.jocull</groupId>
    <artifactId>raftcache</artifactId>
    <version>0.1-SNAPSHOT</version>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.4.0</version>
    </parent>

    <properties>
        <!-- Java 17 is the floor: buildable on any 17+ JDK (17, 21, 22, 25, ...), and the
             release=17 compiler setting enforces that the code depends only on APIs present
             in 17, so the bytecode runs unchanged on a 17 runtime. The compiler itself may
             be any newer JDK installed on the build machine. -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Only the logging half of the old spring-boot-starter: the starter itself
             (Spring Boot 2.4.0, bundled Spring 5.3.1) cannot parse this project's
             Java-17-and-up bytecode, so no Spring context can ever start here. The parent
             BOM still pins the version. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
        </dependency>
        <!-- Wire codec (SCOPE.md Decision #9 successor / Follow-up #11, 2026-11-24,
             new-dependency gate cleared by the user): the protobuf-java runtime for
             the generated wire messages in src/main/proto/wire.proto. The .proto file
             is the compatibility contract; field numbers there are frozen. -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.35.0</version>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.15</version>
        </dependency>

        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>1.7.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Codegen for src/main/proto/*.proto (Follow-up #11). Generates Java
                 into the com.github.jocull.raftcache.lib.raft.messages.proto package
                 (set in wire.proto's java_package option) — a separate package from
                 the hand-written lib/raft/messages POJOs on purpose, so the generated
                 classes never collide with them; the codec adapter (Step B) maps
                 POJO <-> generated message at the SocketChannelMiddleware frame seam.
             -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:4.35.0:exe:${os.detected.classifier}</protocArtifact>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-protos</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <extensions>
            <!-- Resolves ${os.detected.classifier} (linux-x86_64 / osx-x86_64 / ...)
                 for the protoc artifact above, so the build is portable. -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
    </build>

</project>